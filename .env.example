# Copy to .env and fill in (or export these directly in your shell).
# python-dotenv is included in requirements.txt if you want auto-loading.

# --- Generation backend (pick one; Groq preferred) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- OCR ---
OCR_ENGINE=tesseract          # tesseract | paddleocr
TESSERACT_LANG=eng
OCR_LANGUAGES=en              # paddleocr language code

# --- Parsing ---
UNSTRUCTURED_STRATEGY=hi_res  # hi_res | fast | ocr_only

# --- Retrieval ---
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Models ---
CAPTION_MODEL_NAME=Salesforce/blip-image-captioning-base
TEXT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLIP_MODEL_NAME=sentence-transformers/clip-ViT-B-32
